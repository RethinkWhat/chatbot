# Use official PyTorch image with CUDA 12.1 and cuDNN 8
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

# Set environment variables
ENV TRANSFORMERS_VERBOSITY=info
ENV HF_HUB_DISABLE_PROGRESS_BARS=1

# Set working directory
WORKDIR /app

# Install Git, basic utilities, and uvicorn (if not in requirements.txt)
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/* \
    && pip install uvicorn

# Set up a virtual environment (optional)
RUN python -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

# Copy and install Python dependencies from requirements.txt
COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt

# Verify PyTorch version (should be >= 2.1.0)
RUN python -c "import torch; print(f'Torch version: {torch.__version__}')"

# Verify Transformers version
RUN python -c "import transformers; print(f'Transformers version: {transformers.__version__}')"

# Preload the SmolLM3-3B model into cache (this speeds up first run in environments without volume cache)
RUN python -c "\
from transformers import AutoTokenizer, AutoModelForCausalLM; \
AutoTokenizer.from_pretrained('HuggingFaceTB/SmolLM3-3B'); \
AutoModelForCausalLM.from_pretrained('HuggingFaceTB/SmolLM3-3B')"

# Copy app code to the container
COPY ./app ./app

# Set environment variable for CUDA device visibility (optional)
ENV CUDA_VISIBLE_DEVICES=0

# Expose port and run the app using uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8500"]
